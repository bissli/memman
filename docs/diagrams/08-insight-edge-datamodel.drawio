        <mxCell id="dm_fields" value="&lt;table style=&quot;font-size:10px; border-collapse:collapse; width:100%&quot;&gt;&lt;tr style=&quot;background:#6c8ebf; color:white; font-weight:bold;&quot;&gt;&lt;td style=&quot;padding:4px 8px; border:1px solid #6c8ebf;&quot;&gt;Field&lt;/td&gt;&lt;td style=&quot;padding:4px 8px; border:1px solid #6c8ebf;&quot;&gt;Type&lt;/td&gt;&lt;td style=&quot;padding:4px 8px; border:1px solid #6c8ebf;&quot;&gt;Description&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;id&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Primary key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;content&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Memory content (a write is capped at 1000 UTF-8 bytes)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;category&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;preference | decision | fact | insight | context&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;importance&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;1-5, sort key, stored as passed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;source&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Provenance, stored verbatim: user / agent / external&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;entities&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;JSON&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Caller-named entities (a typed list holds at most 50)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;embedding&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;BLOB / vector(N)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Nd float64 (8N bytes); dim per active provider&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Creation timestamp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;deleted_at&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Soft-delete marker (NULL if active)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;linked_at, enriched_at&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Worker pipeline progress timestamps&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;prompt_version, embedding_model&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Provenance - used by graph rebuild and embed reembed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;queue_uuid&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Idempotency key minted at enqueue; one write stores one row&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd; font-family:monospace;&quot;&gt;author&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:3px 8px; border:1px solid #ddd;&quot;&gt;Who wrote it; nullable, falls back to getpass.getuser()&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#f5f5f5;strokeColor=#6c8ebf;" vertex="1" parent="1">
