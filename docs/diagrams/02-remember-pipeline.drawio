<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="remember" name="Remember Pipeline">
    <mxGraphModel dx="1422" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r_title" value="&lt;b&gt;memman remember Pipeline (deferred, two-tier)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="280" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="t1_box" value="&lt;b&gt;Tier 1 - Synchronous queue-append (host session, ~50 ms)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="240" as="geometry" />
        </mxCell>

        <mxCell id="r_start" value="memman remember &amp;lt;content&amp;gt;&lt;br&gt;[--cat --imp --entity --source --session]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r_validate" value="Validate args&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;importance ∈ [1,5] (CLI) ;&lt;br&gt;content ≤ 1000 UTF-8 bytes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r_check_state" value="Check scheduler state&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;reject when STOPPED&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="r_reject" value="Scheduler is stopped;&lt;br&gt;cannot remember." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r_enqueue" value="Append row to ~/.memman/queue.db (SQLite WAL, always)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;status='pending', priority, queued_at,&lt;br&gt;hint_cat / hint_imp / hint_entities / hint_source / hint_replaced_id / session_id / queue_uuid / author&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r_return" value="Return JSON&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;{action: queued, queue_id: N, queue_uuid: U, store, quality_warnings}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="190" width="370" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r_t1_note" value="&lt;font style=&quot;font-size:9px;color:#9673a6&quot;&gt;No LLM. No embedding. No similarity scan. The host session never blocks on the network.&lt;/font&gt;" style="text;html=1;align=left;fontSize=9;fillColor=none;strokeColor=none;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="r_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_start" target="r_validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_validate" target="r_check_state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e3" value="STOPPED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="r_check_state" target="r_reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e4" value="STARTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;" edge="1" parent="1" source="r_check_state" target="r_enqueue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_enqueue" target="r_return">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="r_trigger" value="&lt;b&gt;Trigger&lt;/b&gt;  systemd timer (Linux)  ·  launchd agent (macOS)  ·  serve loop PID 1 (container)" style="text;html=1;align=center;fontSize=12;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1020" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r_trigger_arrow" value="every 60 s (or continuous if --interval 0)" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="345" as="sourcePoint" />
            <mxPoint x="550" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t2_box" value="&lt;b&gt;Tier 2 - Background worker (memman scheduler drain --timeout 60)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d6b656;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="385" width="1020" height="535" as="geometry" />
        </mxCell>

        <mxCell id="r_lock" value="acquire flock on ~/.memman/drain.lock&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;drains never overlap; concurrent triggers exit 0 with 'another drain in progress'&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="500" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r_claim" value="Atomic claim&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;UPDATE queue SET claimed_at=..., attempts=attempts+1&lt;br&gt;WHERE id = (SELECT ... WHERE status='pending'&lt;br&gt;ORDER BY priority DESC, queued_at ASC LIMIT 1) RETURNING ...&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="r_idem" value="Idempotency check&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;if any insight carries the row's queue_uuid&lt;br&gt;→ skip + mark done (crash recovery)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="495" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r_qg" value="Quality gate&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;check_content_quality(content)&lt;br&gt;advisory warnings only; never blocks the write&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="r_perfact" value="&lt;b&gt;Per write&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="665" width="940" height="160" as="geometry" />
        </mxCell>

        <mxCell id="r_apply" value="&lt;b&gt;Plan&lt;/b&gt; (no DB writes)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;enrich_with_llm() - keywords, summary&lt;br&gt;embed once: keyword-enriched text, or content alone&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Apply action&lt;/b&gt; (one transaction)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;INSERT (add) / supersede + INSERT (replace), vector, caller entities&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="700" width="800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r_parallel" value="&lt;b&gt;Stamp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;stamp_linked · update_enrichment (keywords, summary) · stamp_enriched&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="845" width="940" height="55" as="geometry" />
        </mxCell>

        <mxCell id="r_done" value="mark_done(queue_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="935" width="1020" height="40" as="geometry" />
        </mxCell>

        <mxCell id="r_e_lock_claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_lock" target="r_claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_claim_idem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_claim" target="r_idem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_idem_qg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_idem" target="r_qg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_qg_pf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_qg" target="r_perfact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_pf_par" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_perfact" target="r_parallel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_par_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r_parallel" target="r_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
