<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="remember" name="Write Pipeline">
    <mxGraphModel dx="1422" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r_title" value="&lt;b&gt;Write Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;remember and replace queue the write in the turn. The background worker enriches, embeds, and stores it.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="800" height="45" as="geometry" />
        </mxCell>

        <mxCell id="t1_box" value="&lt;b&gt;In the turn&lt;/b&gt;  memman remember or memman replace" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1020" height="300" as="geometry" />
        </mxCell>
        <mxCell id="r_start" value="&lt;b&gt;memman remember &amp;lt;content&amp;gt;&lt;br&gt;memman replace &amp;lt;id&amp;gt; &amp;lt;content&amp;gt;&lt;/b&gt;&lt;br&gt;Options: --cat. On replace, an unflagged option inherits the target's value." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r_check_state" value="Scheduler&lt;br&gt;STOPPED?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="102" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_reject" value="&lt;b&gt;Exit 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:9px&quot;&gt;Scheduler is stopped; cannot write.&lt;br&gt;Run 'memman scheduler start' to enable.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="112" width="290" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r_validate" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;Refuse text over 1,000 UTF-8 bytes, text naming a line number, text opening with MEMMAN_AUTHOR, text spanning lines, and text opening with a label. Refuse an unknown category. On replace, the target must be current. Add advisory quality warnings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r_enqueue" value="&lt;b&gt;Append a row to queue.db&lt;/b&gt;&lt;br&gt;status pending, content, hint_cat, hint_replaced_id (replace only), a new queue_uuid, author" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="215" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r_return" value="&lt;b&gt;Print JSON&lt;/b&gt;&lt;br&gt;action: queued, queue_id, queue_uuid, store, quality_warnings, and replaced_id on replace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="215" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r_t1_note" value="No LLM call and no embedding run in the turn." style="text;html=1;align=left;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="342" width="600" height="20" as="geometry" />
        </mxCell>

        <mxCell id="r_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_start" target="r_check_state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#b85450;labelBackgroundColor=#e1d5e7;" edge="1" parent="1" source="r_check_state" target="r_reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#e1d5e7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_check_state" target="r_validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_validate" target="r_enqueue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_enqueue" target="r_return">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="r_trigger" value="&lt;b&gt;A drain runs once per interval (default 60 seconds)&lt;/b&gt;&lt;br&gt;systemd timer on Linux, launchd agent on macOS, memman scheduler serve in a container" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="1020" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r_trigger_arrow" style="endArrow=classic;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="418" as="sourcePoint" />
            <mxPoint x="550" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t2_box" value="&lt;b&gt;Background worker&lt;/b&gt;  memman scheduler drain" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d6b656;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1020" height="760" as="geometry" />
        </mxCell>
        <mxCell id="r_lock" value="&lt;b&gt;Take the flock on drain.lock&lt;/b&gt;&lt;br&gt;If another drain holds it, exit at once." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="475" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_claim" value="&lt;b&gt;Claim the next pending row&lt;/b&gt;&lt;br&gt;Highest priority, then oldest. Adds 1 to attempts. Stops at 100 rows, the timeout, an empty queue, or a STOPPED scheduler." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="545" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_idem" value="A memory not forgotten&lt;br&gt;holds this queue_uuid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="625" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_skip" value="&lt;b&gt;Mark the row done, store nothing&lt;/b&gt;&lt;br&gt;A crashed drain already stored it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="640" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_redirect" value="&lt;b&gt;On replace, find the current target&lt;/b&gt;&lt;br&gt;Follow superseded_by from the named row to the head of its chain." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="725" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_plan" value="&lt;b&gt;Plan, with no database write&lt;/b&gt;&lt;br&gt;One enrichment call returns a summary, with a second call when the reply does not parse. One embedding call embeds the content. A failed call leaves the row without that output. A missing embedding key or LLM setting fails the row." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="795" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_apply" value="&lt;b&gt;Apply in one transaction&lt;/b&gt;&lt;br&gt;Insert the row. On replace, supersede the target. If the target is not current, store a plain add and log target-gone. Write the vector and summary. Stamp linked_at. Stamp enriched_at only when enrichment and a vector both landed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="895" width="460" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r_done" value="&lt;b&gt;Mark the row done&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="1010" width="460" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r_failed" value="&lt;b&gt;On an error, retry with backoff&lt;/b&gt;&lt;br&gt;The row unlocks after 60, 120, 240, then 480 seconds. After 5 attempts its status is failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="907" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r_maint" value="&lt;b&gt;After the row loop&lt;/b&gt;&lt;br&gt;Purge done rows, prune worker_runs, and return stale rows to pending. For each store the drain wrote to: drop oplog rows older than 180 days, reset up to 3 memories that have linked_at but no enriched_at, and enrich up to 3 memories with no linked_at. Then run the daily model check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="1090" width="840" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r_e_lock_claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_lock" target="r_claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_claim_idem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_claim" target="r_idem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_idem_skip" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#fce5cd;" edge="1" parent="1" source="r_idem" target="r_skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_idem_redirect" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#fce5cd;" edge="1" parent="1" source="r_idem" target="r_redirect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_redirect_plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_redirect" target="r_plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_plan_apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_plan" target="r_apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_apply_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="r_apply" target="r_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_fail" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;strokeColor=#b85450;labelBackgroundColor=#fce5cd;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_apply" target="r_failed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_e_loop" value="next row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#fce5cd;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_done" target="r_claim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="70" y="1028" />
              <mxPoint x="70" y="575" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r_e_done_maint" value="loop ends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#fce5cd;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_claim" target="r_maint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="563" />
              <mxPoint x="990" y="1130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r_e_skip_loop" value="next row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#fce5cd;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_skip" target="r_claim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="587" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r_e_fail_loop" value="next row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#fce5cd;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_failed" target="r_claim">
          <mxGeometry x="-0.8" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="1066" />
              <mxPoint x="70" y="1066" />
              <mxPoint x="70" y="575" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
