<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="datamodel" name="Memory Data Model">
    <mxGraphModel dx="1422" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dm_title" value="&lt;b&gt;Memory Data Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;One insights row per memory. SQLite types shown. Postgres uses timestamptz, jsonb, and vector(N).&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="720" height="45" as="geometry" />
        </mxCell>

        <mxCell id="dm_insight_box" value="&lt;b&gt;insights&lt;/b&gt;  one row per memory" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="660" height="450" as="geometry" />
        </mxCell>
        <mxCell id="dm_fields" value="&lt;table style=&quot;font-size:10px; border-collapse:collapse; width:100%&quot;&gt;&lt;tr style=&quot;background:#6c8ebf; color:white; font-weight:bold;&quot;&gt;&lt;td style=&quot;padding:4px 6px; border:1px solid #6c8ebf;&quot;&gt;Column&lt;/td&gt;&lt;td style=&quot;padding:4px 6px; border:1px solid #6c8ebf;&quot;&gt;Type&lt;/td&gt;&lt;td style=&quot;padding:4px 6px; border:1px solid #6c8ebf;&quot;&gt;Meaning&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;id&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;UUID, primary key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;content&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;The memory as written. remember and replace refuse text over 1,000 UTF-8 bytes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;category&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;preference, decision, fact, insight, or context. Default fact.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;summary&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;One-sentence summary from enrichment&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;embedding&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;blob&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;The vector, little-endian float64, 8 bytes per dimension&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;embedding_pending&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;blob&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;The target vector while embed swap runs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;linked_at&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text (time)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Set when the worker stores the row. Null marks a row still to enrich.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;enriched_at&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text (time)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Set once enrichment and a vector both land&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;created_at, updated_at&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text (time)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Creation and last-update times&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;deleted_at&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text (time)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Set by forget. Null unless forgotten.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;superseded_by&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;The successor id. Null unless superseded.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;prompt_version&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Hash of the enrichment prompt and model. graph rebuild --stale-only reads it.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;embedding_model&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;The model that made the vector. embed reembed reads it.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;queue_uuid&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Minted at enqueue. The worker skips a write whose uuid a memory not forgotten already holds.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;author&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;MEMMAN_AUTHOR at write time, else the login name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; font-family:monospace;&quot;&gt;kw_tokens&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left; white-space:nowrap;&quot;&gt;text[]&lt;/td&gt;&lt;td style=&quot;padding:3px 6px; border:1px solid #ddd; vertical-align:top; text-align:left;&quot;&gt;Postgres only: the distinct tokens of content, GIN-indexed&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="55" y="100" width="630" height="405" as="geometry" />
        </mxCell>

        <mxCell id="dm_states" value="&lt;b&gt;States of a memory&lt;/b&gt;&lt;br&gt;&lt;b&gt;current&lt;/b&gt;: deleted_at is null and superseded_by is null. Only current rows reach recall.&lt;br&gt;&lt;b&gt;superseded&lt;/b&gt;: superseded_by names the successor. The content stays in the row.&lt;br&gt;&lt;b&gt;forgotten&lt;/b&gt;: deleted_at is set (soft delete). The content stays in the row.&lt;br&gt;No cap and no automatic deletion." style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="660" height="110" as="geometry" />
        </mxCell>

        <mxCell id="dm_store_box" value="&lt;b&gt;Other tables in each store&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d6b656;verticalAlign=top;absoluteArcSize=1;arcSize=20;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="70" width="460" height="340" as="geometry" />
        </mxCell>
        <mxCell id="dm_oplog" value="&lt;b&gt;oplog&lt;/b&gt;: audit trail, one row per operation&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:9px&quot;&gt;id, operation, insight_id, detail, before, after, created_at&lt;/font&gt;&lt;br&gt;Postgres adds legacy_id. After a drain writes to the store, the worker drops rows older than 180 days." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="100" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dm_meta" value="&lt;b&gt;meta&lt;/b&gt;: key and value&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:9px&quot;&gt;embed_fingerprint, embed_swap_*, embed_reembed_state, embed_reembed_cursor&lt;/font&gt;&lt;br&gt;embed_fingerprint records the store's embedding model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="182" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dm_fts" value="&lt;b&gt;insights_fts&lt;/b&gt; (SQLite only): FTS5 index over content, kept in step by triggers. Postgres uses the kw_tokens column instead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="264" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dm_pg_runs" value="&lt;b&gt;worker_runs&lt;/b&gt; (Postgres only): drain heartbeats for this store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="336" width="430" height="55" as="geometry" />
        </mxCell>

        <mxCell id="dm_queue_box" value="&lt;b&gt;queue.db&lt;/b&gt;  SQLite, one per data directory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;absoluteArcSize=1;arcSize=20;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="430" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dm_queue" value="&lt;b&gt;queue&lt;/b&gt;: one row per queued write&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:9px&quot;&gt;store, content, hint_cat, hint_replaced_id, queue_uuid, author, attempts, status&lt;/font&gt;&lt;br&gt;status is pending, done, failed, or stale." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="460" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dm_queue_runs" value="&lt;b&gt;worker_runs&lt;/b&gt;: drain history: rows claimed, done, and failed per drain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="565" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dm_backends" value="&lt;b&gt;Storage backends&lt;/b&gt;&lt;br&gt;&lt;b&gt;SQLite&lt;/b&gt; (default): ~/.memman/data/&amp;lt;store&amp;gt;/memman.db&lt;br&gt;&lt;b&gt;Postgres&lt;/b&gt; with pgvector: schema store_&amp;lt;name&amp;gt; in the configured DSN&lt;br&gt;&lt;b&gt;Queue&lt;/b&gt;: ~/.memman/queue.db, SQLite always" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1150" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
