        <mxCell id="a_l3" value="&lt;b&gt;Write path&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
