        <mxCell id="e_cli_direct" value="forget, reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6c8ebf;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3565;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_cli_mem" target="a_l5">
