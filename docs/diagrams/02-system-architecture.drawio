        </mxCell>
        <mxCell id="a_queue" value="&lt;b&gt;queue.py&lt;/b&gt;&lt;br&gt;queue.db: append, claim, retry with backoff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_sched" value="&lt;b&gt;setup/scheduler.py&lt;/b&gt;&lt;br&gt;systemd timer, launchd agent, or serve loop. State STARTED or STOPPED." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="305" y="350" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_lock" value="&lt;b&gt;drain_lock.py&lt;/b&gt;&lt;br&gt;flock on drain.lock: one drain at a time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="350" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_pipeline" value="&lt;b&gt;pipeline/remember.py&lt;/b&gt;&lt;br&gt;Enrich and embed one write, then apply it in one transaction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="436" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_graph" value="&lt;b&gt;graph/&lt;/b&gt;&lt;br&gt;enrichment.py: the model call. engine.py: enriches pending rows." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="305" y="436" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_maint" value="&lt;b&gt;maintenance.py&lt;/b&gt;&lt;br&gt;After each drain: purge done rows, retry stale rows, trim the oplog, re-enrich" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="436" width="230" height="56" as="geometry" />
        </mxCell>

        <mxCell id="a_search" value="&lt;b&gt;search/&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="320" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="a_recall" value="&lt;b&gt;recall.py&lt;/b&gt;&lt;br&gt;Keyword, vector, and recency channels, RRF fusion, blend, rerank" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="350" width="165" height="142" as="geometry" />
        </mxCell>
        <mxCell id="a_kw" value="&lt;b&gt;keyword.py&lt;/b&gt;&lt;br&gt;Tokenizer and keyword score" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="350" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_quality" value="&lt;b&gt;quality.py&lt;/b&gt;&lt;br&gt;Advisory warnings on write text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="436" width="160" height="56" as="geometry" />
        </mxCell>

        <mxCell id="a_l4" value="&lt;b&gt;Providers&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a_embed" value="&lt;b&gt;embed/&lt;/b&gt;&lt;br&gt;voyage, openai, openrouter, and ollama clients. fingerprint.py binds each store to one model. swap.py changes it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_llm" value="&lt;b&gt;llm/&lt;/b&gt;&lt;br&gt;client.py: one OpenAI-compatible client. openrouter_models.py: the daily model check. usage.py: token counts." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="560" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_rerank" value="&lt;b&gt;rerank/&lt;/b&gt;&lt;br&gt;voyage.py: the cross-encoder, default model rerank-3-lite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="560" width="360" height="64" as="geometry" />
        </mxCell>

        <mxCell id="a_l5" value="&lt;b&gt;Storage&lt;/b&gt;  store/, migrate/, backup/" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d6b656;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
