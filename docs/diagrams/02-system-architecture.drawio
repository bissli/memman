        </mxCell>
        <mxCell id="a_backend" value="&lt;b&gt;store/backend.py, store/factory.py&lt;/b&gt;&lt;br&gt;Backend protocol: nodes, meta, oplog, recall session. factory.py picks the backend per store." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_sqlite" value="&lt;b&gt;store/sqlite.py, db.py, node.py, oplog.py&lt;/b&gt;&lt;br&gt;SQLite in WAL mode: data/&amp;lt;store&amp;gt;/memman.db" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="690" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_postgres" value="&lt;b&gt;store/postgres.py&lt;/b&gt;&lt;br&gt;Postgres with pgvector: one schema, store_&amp;lt;name&amp;gt;, per store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="690" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_migrate" value="&lt;b&gt;migrate/&lt;/b&gt;&lt;br&gt;Copies a store between SQLite and Postgres" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="768" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_backup" value="&lt;b&gt;backup/&lt;/b&gt;&lt;br&gt;Backs up every store to an external directory, on demand or on a schedule, and restores it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="768" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_tables" value="&lt;b&gt;Tables&lt;/b&gt;&lt;br&gt;Each store: insights, oplog, meta, plus insights_fts (SQLite) or worker_runs (Postgres). queue.db: queue, worker_runs.&lt;br&gt;insights: no cap, no automatic deletion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="1">
