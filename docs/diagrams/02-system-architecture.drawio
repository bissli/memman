        </mxCell>
        <mxCell id="a_claude" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;The agent. Runs memman verbs through Bash." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_hooks" value="&lt;b&gt;Hooks&lt;/b&gt;&lt;br&gt;prime.sh, user_prompt.sh, compact.sh, task_recall.sh, exit_plan.sh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="285" y="100" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_guide" value="&lt;b&gt;Guide&lt;/b&gt;&lt;br&gt;guide.md: the recall and remember commands. memman prime prints it at session start." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="100" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_skill" value="&lt;b&gt;Skill&lt;/b&gt;&lt;br&gt;SKILL.md: the full manual, loaded on demand" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="735" y="100" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_setup" value="&lt;b&gt;setup/&lt;/b&gt;&lt;br&gt;memman install: links the hooks and skill, merges settings.json, installs the scheduler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="220" height="64" as="geometry" />
        </mxCell>

        <mxCell id="a_l2" value="&lt;b&gt;CLI&lt;/b&gt;  cli.py (Click)" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a_cli_mem" value="&lt;b&gt;Memory verbs&lt;/b&gt;&lt;br&gt;remember, replace, supersede, unsupersede, forget, recall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a_cli_groups" value="&lt;b&gt;Command groups&lt;/b&gt;&lt;br&gt;insights, graph, embed, store, scheduler, backup, log, config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="360" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a_cli_ops" value="&lt;b&gt;Other verbs&lt;/b&gt;&lt;br&gt;install, uninstall, migrate, status, doctor, and prime (hidden, run by prime.sh)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="230" width="360" height="54" as="geometry" />
